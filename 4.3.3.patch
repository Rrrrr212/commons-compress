+package org.apache.commons.compress.archivers.zip;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Enumeration;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+/**
+ * Utility to process ZIP files containing DEFLATE64 entries using a strict/lenient mixed mode.
+ */
+public class Deflate64RobustZipExtractor {
+
+    private static final Logger LOGGER = Logger.getLogger(Deflate64RobustZipExtractor.class.getName());
+
+    /**
+     * Extracts or verifies a ZIP file using ZipFile with strict size checks and lenient error handling.
+     *
+     * @param zipFile the ZIP file to process
+     * @throws IOException if the ZIP file cannot be opened
+     */
+    public static void processZipLeniently(File zipFile) throws IOException {
+        boolean firstCorruptedFound = false;
+
+        // Lenient mode: setIgnoreLocalFileHeader(true) allows bypassing corrupt local headers
+        try (ZipFile zf = ZipFile.builder()
+                .setFile(zipFile)
+                .setIgnoreLocalFileHeader(true)
+                .get()) {
+
+            Enumeration<ZipArchiveEntry> entries = zf.getEntries();
+            while (entries.hasMoreElements()) {
+                ZipArchiveEntry entry = entries.nextElement();
+                
+                if (entry.isDirectory()) {
+                    continue;
+                }
+
+                long expectedSize = entry.getSize();
+                long compressedSize = entry.getCompressedSize();
+
+                // Strict mode: Pre-decompression size validation
+                if (expectedSize == ZipArchiveEntry.SIZE_UNKNOWN || expectedSize < 0) {
+                    LOGGER.warning(String.format("Entry %s has unknown or invalid expected size. Skipping.", entry.getName()));
+                    continue;
+                }
+                
+                if (compressedSize < 0 && entry.getMethod() == java.util.zip.ZipEntry.DEFLATED) {
+                    LOGGER.warning(String.format("Entry %s has invalid compressed size. Skipping.", entry.getName()));
+                    continue;
+                }
+
+                try (InputStream is = zf.getInputStream(entry)) {
+                    // It is possible that getInputStream returns null if the entry cannot be read
+                    if (is == null) {
+                        throw new IOException("Cannot get InputStream for entry: " + entry.getName());
+                    }
+
+                    byte[] buffer = new byte[8192];
+                    long totalRead = 0;
+                    int read;
+                    while ((read = is.read(buffer)) != -1) {
+                        totalRead += read;
+                        // Strict mode: runtime size check
+                        if (totalRead > expectedSize) {
+                            throw new IOException("Decompressed size exceeds expected size: " + expectedSize);
+                        }
+                    }
+
+                    // Strict mode: post-decompression size check
+                    if (totalRead != expectedSize) {
+                        throw new IOException(String.format("Size mismatch: expected %d, but read %d", expectedSize, totalRead));
+                    }
+
+                } catch (IOException e) {
+                    // Lenient mode: Catch IOException, log and skip to next entry
+                    if (!firstCorruptedFound) {
+                        System.out.println("DEBUG: First corrupted entry found: " + entry.getName());
+                        firstCorruptedFound = true;
+                    }
+                    LOGGER.log(Level.WARNING, String.format("Skipping corrupted entry: %s, Expected Size: %d, Error: %s",
+                            entry.getName(), expectedSize, e.getMessage()));
+                }
+            }
+        }
+    }
+}
