+package org.apache.commons.compress.utils;
+
+import static org.junit.Assert.assertEquals;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Random;
+import java.util.zip.Adler32;
+
+import org.junit.Test;
+
+public class ChecksumUtilsTest {
+
+    private long calculateExpectedAdler32(final byte[] data) {
+        final Adler32 adler32 = new Adler32();
+        adler32.update(data, 0, data.length);
+        return adler32.getValue();
+    }
+
+    @Test
+    public void testCalculateAdler32WithEmptyInputStream() throws IOException {
+        assertEquals(1L, ChecksumUtils.calculateAdler32(new ByteArrayInputStream(new byte[0])));
+    }
+
+    @Test
+    public void testCalculateAdler32WithHelloWorld() throws IOException {
+        final byte[] data = "hello world".getBytes(StandardCharsets.UTF_8);
+        assertEquals(calculateExpectedAdler32(data), ChecksumUtils.calculateAdler32(new ByteArrayInputStream(data)));
+    }
+
+    @Test
+    public void testCalculateAdler32WithLargeRandomData() throws IOException {
+        final byte[] data = new byte[10 * 1024 * 1024];
+        new Random(123456789L).nextBytes(data);
+        final InputStream input = new ByteArrayInputStream(data);
+        assertEquals(calculateExpectedAdler32(data), ChecksumUtils.calculateAdler32(input));
+    }
+
+    @Test(expected = NullPointerException.class)
+    public void testCalculateAdler32WithNullInputStream() throws IOException {
+        ChecksumUtils.calculateAdler32(null);
+    }
+
+    @Test
+    public void testCalculateAdler32WithSingleByteInputStream() throws IOException {
+        final byte[] data = new byte[] { 42 };
+        assertEquals(calculateExpectedAdler32(data), ChecksumUtils.calculateAdler32(new ByteArrayInputStream(data)));
+    }
+}
