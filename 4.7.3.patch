diff --git a/ci-build-check.sh b/ci-build-check.sh
new file mode 100644
index 000000000..090e7c363
--- /dev/null
+++ b/ci-build-check.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+
+# 遇到错误立即退出，未定义的变量报错，管道中任意命令失败则整个管道失败
+set -euo pipefail
+
+echo "======================================================"
+echo " 🚀 Starting CI/Local Build Check Script"
+echo "======================================================"
+
+# 1. 自动检测 JDK 版本是否为 8+
+echo "[INFO] 🔍 Checking JDK version..."
+if ! command -v javac &> /dev/null; then
+    echo "[ERROR] javac not found. Please install JDK."
+    exit 1
+fi
+
+# 解析 JDK 版本号（支持 1.8.x 和 9+ 的格式）
+JAVA_VER=$(javac -version 2>&1 | head -1 | awk '{print $2}' | sed -e 's/"//g' | awk -F'.' '{if ($1 == 1) print $2; else print $1}')
+if [ -z "$JAVA_VER" ]; then
+    JAVA_VER=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | sed '/^1\./s///' | cut -d'.' -f1)
+fi
+
+if [ "$JAVA_VER" -lt 8 ]; then
+    echo "[ERROR] JDK 8+ is required, but found JDK $JAVA_VER."
+    exit 1
+else
+    echo "[INFO] ✅ JDK version check passed: JDK $JAVA_VER."
+fi
+
+# 2. 运行 mvn clean verify 执行完整构建，并生成 jacoco 报告
+echo "[INFO] ⚙️ Running Maven build (mvn clean verify jacoco:report)..."
+BUILD_LOG="build.log"
+
+# 临时关闭 set -e 以便我们能自己捕获 mvn 的失败并分析日志
+set +e
+mvn clean verify jacoco:report -B -V > "$BUILD_LOG" 2>&1
+BUILD_STATUS=$?
+set -e
+
+# 3. 若构建失败，自动输出 target/ 下的错误日志摘要
+# 5. 输出关键调试信息，用于定位构建失败的阶段（编译/测试/检查）
+if [ $BUILD_STATUS -ne 0 ]; then
+    echo "[ERROR] ❌ Maven build failed with exit code $BUILD_STATUS."
+    
+    # 诊断：编译失败
+    if grep -qi "COMPILATION ERROR" "$BUILD_LOG"; then
+        echo "[ERROR] Failure Stage: 🔨 Compilation"
+        echo "[DEBUG] Compilation error details:"
+        grep -A 15 -i "COMPILATION ERROR" "$BUILD_LOG"
+        
+    # 诊断：测试失败
+    elif grep -qi "There are test failures" "$BUILD_LOG" || grep -qi "Tests run:.*, Failures: [1-9].*" "$BUILD_LOG" || grep -qi "Tests run:.*, Errors: [1-9].*" "$BUILD_LOG"; then
+        echo "[ERROR] Failure Stage: 🧪 Testing"
+        echo "[DEBUG] Test error summary from target/surefire-reports:"
+        if [ -d "target/surefire-reports" ]; then
+            # 查找并输出具体的失败原因
+            find target/surefire-reports -name "*.txt" -type f | xargs grep -l -E "Failures: [1-9]|Errors: [1-9]|<<< FAILURE!|<<< ERROR!" | while read -r failed_test_log; do
+                echo "---------------------------------------------------"
+                echo ">> Failed Test Log: $failed_test_log"
+                grep -A 15 -E "<<< FAILURE!|<<< ERROR!|java.lang.AssertionError|Exception" "$failed_test_log" || true
+            done
+        else
+            echo "[WARN] No surefire-reports found. Here is the Maven log output:"
+            grep -A 20 -i "There are test failures" "$BUILD_LOG" || true
+        fi
+        
+    # 诊断：代码检查失败 (Checkstyle/SpotBugs/PMD/etc.)
+    elif grep -qi "Checkstyle execution failed" "$BUILD_LOG" || grep -qi "SpotBugs execution failed" "$BUILD_LOG" || grep -qi "PMD Failure" "$BUILD_LOG"; then
+        echo "[ERROR] Failure Stage: 🔎 Static Code Check (Checkstyle/SpotBugs/PMD/etc.)"
+        echo "[DEBUG] Check failure details:"
+        grep -B 2 -A 10 -i "execution failed" "$BUILD_LOG"
+        
+    # 诊断：其他/未知错误
+    else
+        echo "[ERROR] Failure Stage: ❓ Unknown/Other"
+        echo "[DEBUG] Last 50 lines of build log:"
+        tail -n 50 "$BUILD_LOG"
+    fi
+    exit $BUILD_STATUS
+fi
+
+echo "[INFO] ✅ Maven build completed successfully."
+
+# 4. 生成代码覆盖率报告（jacoco），并检查覆盖率是否低于 80%
+JACOCO_CSV="target/site/jacoco/jacoco.csv"
+echo "[INFO] 📊 Checking JaCoCo code coverage..."
+
+if [ ! -f "$JACOCO_CSV" ]; then
+    echo "[ERROR] JaCoCo report not found at $JACOCO_CSV."
+    echo "Make sure the jacoco-maven-plugin is properly configured in your pom.xml."
+    exit 1
+fi
+
+# 解析 JaCoCo CSV 报告，通过累加所有类的指令覆盖数据 (INSTRUCTION_MISSED $4 和 INSTRUCTION_COVERED $5) 来计算整体覆盖率
+COVERAGE=$(awk -F',' 'NR>1 { missed += $4; covered += $5 } END { if (missed+covered == 0) print 0; else print int((covered/(missed+covered))*100) }' "$JACOCO_CSV")
+
+echo "[INFO] Current Instruction Coverage: ${COVERAGE}%"
+
+if [ "$COVERAGE" -lt 80 ]; then
+    echo "[ERROR] ❌ Code coverage is ${COVERAGE}%, which is below the 80% threshold."
+    exit 1
+else
+    echo "[INFO] ✅ Code coverage check passed (${COVERAGE}% >= 80%)."
+fi
+
+echo "======================================================"
+echo " 🎉 CI/Local Build Check completed successfully!"
+echo "======================================================"
